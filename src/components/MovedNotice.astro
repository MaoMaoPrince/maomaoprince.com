---
interface Props {
  questPage?: boolean;
  notFound?: boolean;
}

const { questPage = false, notFound = false } = Astro.props;
const pageTitle = questPage ? 'Triple Float Fishing Rod Quest | Home for Black Desert Fishing' : 'Home for Black Desert Fishing';
const description = questPage
  ? 'Looking for the Triple Float Fishing Rod quest? Find the Black Desert Fishing guide at its new home on FishyStuff.'
  : 'Home for Black Desert Fishing. Our fishing guides and community have moved to FishyStuff. Find our new home and Triple Float Fishing Rod quest guide.';
const canonical = new URL(questPage ? '/3x-tfr-quest/' : '/', Astro.site).href;
let skySeed = 731;
const skyRandom = () => {
  skySeed = (skySeed * 16807) % 2147483647;
  return skySeed / 2147483647;
};
const stars = Array.from({ length: 38 }, () => ({
  x: skyRandom() * 100,
  y: skyRandom() * 100,
  size: 0.8 + skyRandom() * 1.2,
  opacity: 0.2 + skyRandom() * 0.45,
  delay: -skyRandom() * 20,
  duration: 5 + skyRandom() * 7,
  tint: ['#d6e1ed', '#d6e1ed', '#d6e1ed', '#b9b0dc', '#d4b4c5', '#a9ccde'][Math.floor(skyRandom() * 6)],
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    {notFound ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MaoMaoPrince" />
    {!notFound && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <div class="night-sky" aria-hidden="true">
      {stars.map(star => <span class="star" style={`left:${star.x}%;top:${star.y}%;width:${star.size}px;height:${star.size}px;--star-opacity:${star.opacity};--star-tint:${star.tint};animation-delay:${star.delay}s;animation-duration:${star.duration}s`}></span>)}
    </div>
    <header class="site-header">
      <a class="site-name" href="/">
        <img src="/maomaoprince.png" alt="" width="28" height="28" />
        <span>maomaoprince.com</span>
      </a>
      <a class="discord-link" href="https://discord.gg/xRBqjyQ" aria-label="Join the Discord">
        <span class="discord-icon" aria-hidden="true"></span>
        <span class="discord-label">Join the Discord</span>
      </a>
    </header>
    <main class:list={{ homepage: !questPage }}>
      <img class="hero-mascot" src="/maomaoMunch.gif" alt="MaoMao munching" width="128" height="128" />
      {questPage ? (
        <>
          <h1>Looking for the <button class="item-name" type="button" aria-controls="rod-preview" aria-expanded="false"><span class="item-bracket">[</span><span>Triple-Float Fishing Rod</span><span class="item-bracket">]</span></button> quest?</h1>
          <p class="guide-moved">The guide has moved to the new home of Black Desert Fishing:</p>
          <a class="quest-destination" href="https://fishystuff.fish/guides/3x-tfr-quest/">https://fishystuff.fish/guides/3x-tfr-quest/</a>
        </>
      ) : (
        <>
          <h1>Black Desert Fishing has moved to a new home</h1>
          <a class="quest-destination" href="https://fishystuff.fish/">https://fishystuff.fish/</a>
          <section class="quest" aria-labelledby="quest-heading">
            <h2 id="quest-heading">Looking for the <button class="item-name" type="button" aria-controls="rod-preview" aria-expanded="false"><span class="item-bracket">[</span><span>Triple-Float Fishing Rod</span><span class="item-bracket">]</span></button> quest?</h2>
            <a class="quest-destination" href="https://fishystuff.fish/guides/3x-tfr-quest/">https://fishystuff.fish/guides/3x-tfr-quest/</a>
          </section>
        </>
      )}

    </main>
    <aside id="rod-preview" class="rod-preview" popover="auto" aria-label="Triple-Float Fishing Rod item details">
      <div class="rod-title"><img src="/triple-float-rod.webp" alt="" width="40" height="40" /><div><strong>Triple-Float Fishing Rod</strong><small>Equipment · 1.00 LT</small></div></div>
      <p class="rod-requirement">Requires Fishing Skilled 5</p>
      <p>Catch several fish in one cast.</p>
      <dl><div><dt>Rare fish chance</dt><dd>+2%</dd></div><div><dt>High-quality fish chance</dt><dd>+5%</dd></div><div><dt>Durability</dt><dd>135 / 135</dd></div></dl>
      <a href="https://bdocodex.com/us/item/16153/" target="_blank" rel="noopener noreferrer">View item on BDO Codex ↗</a>
    </aside>
    <footer aria-label="FishyStuff and MaoMaoPrince">
      <canvas class="water-back" aria-hidden="true"></canvas>
      <canvas class="water-front" aria-hidden="true"></canvas>
      <div class="rod-lane" aria-hidden="true"><img class="drifting-rod" src="/triple-float-rod.webp" alt="" width="36" height="36" /><img class="drifting-banana" src="/banana.webp" alt="" width="48" height="42" /></div>
      <button class="water-toggle" type="button" aria-label="Make the water choppier and faster" aria-pressed="false" title="Click for choppy water"></button>
      <div class="brandmarks">
      <a class="brand maomaoprince" href="/">
        <img src="/maomaoprince.png" alt="" width="56" height="56" />
        <span>MaoMaoPrince</span>
      </a>
      <a class="brand fishystuff" href="https://fishystuff.fish/">
        <span>FishyStuff</span>
        <img src="/fishystuff-logo.png" alt="" width="56" height="56" />
      </a>
      </div>
    </footer>
  </body>
</html>

<script>
  const sky = document.querySelector<HTMLElement>('.night-sky');
  const hero = document.querySelector<HTMLElement>('.hero-mascot');
  const header = document.querySelector<HTMLElement>('.site-header');
  if (sky && hero && header) {
    const positionStars = () => {
      const bounds = hero.getBoundingClientRect();
      sky.style.height = `${Math.max(0, bounds.top - document.body.getBoundingClientRect().top + bounds.height * 0.85)}px`;
    };
    const skyObserver = new ResizeObserver(positionStars);
    skyObserver.observe(hero);
    skyObserver.observe(header);
    window.addEventListener('resize', positionStars);
    positionStars();
  }
  const itemTrigger = document.querySelector<HTMLButtonElement>('.item-name');
  const itemPreview = document.querySelector<HTMLElement>('#rod-preview');
  if (itemTrigger && itemPreview) {
    let pinned = false;
    let pointerWithin = false;
    let pointerDriven = false;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;
    const cancelClose = () => { clearTimeout(closeTimer); closeTimer = undefined; };
    const closePreview = () => { cancelClose(); itemPreview.hidePopover(); pinned = false; };
    const positionPreview = (pointer?: { clientX: number; clientY: number }) => {
      const bounds = itemPreview.getBoundingClientRect();
      let left: number;
      let top: number;
      if (pointer) {
        left = pointer.clientX + 16;
        if (left + bounds.width > window.innerWidth - 12) left = pointer.clientX - bounds.width - 16;
        top = pointer.clientY + 12;
      } else {
        const anchor = itemTrigger.getBoundingClientRect();
        left = anchor.left + anchor.width / 2 - bounds.width / 2;
        top = anchor.bottom + 10 + bounds.height <= window.innerHeight - 12 ? anchor.bottom + 10 : anchor.top - bounds.height - 10;
      }
      itemPreview.style.left = `${Math.max(12, Math.min(left, window.innerWidth - bounds.width - 12))}px`;
      itemPreview.style.top = `${Math.max(12, Math.min(top, window.innerHeight - bounds.height - 12))}px`;
    };
    const openPreview = (pointer?: { clientX: number; clientY: number }) => {
      cancelClose();
      pointerDriven = Boolean(pointer);
      itemPreview.showPopover();
      positionPreview(pointer);
    };
    const scheduleClose = () => {
      if (pinned || closeTimer !== undefined) return;
      closeTimer = setTimeout(() => {
        closeTimer = undefined;
        const keyboardWithin = !pointerDriven && (itemTrigger === document.activeElement || itemPreview.contains(document.activeElement));
        if (!pointerWithin && !keyboardWithin) closePreview();
      }, 180);
    };
    itemTrigger.addEventListener('pointerenter', event => { if (event.pointerType !== 'touch') openPreview(event); });
    itemTrigger.addEventListener('pointermove', event => {
      if (!pinned && event.pointerType !== 'touch' && itemPreview.matches(':popover-open')) positionPreview(event);
    });
    const pointerLeft = () => { pointerWithin = false; scheduleClose(); };
    itemTrigger.addEventListener('pointerleave', pointerLeft);
    itemTrigger.addEventListener('focus', () => openPreview());
    itemTrigger.addEventListener('click', event => {
      if (pinned) closePreview();
      else {
        const mouseClick = event instanceof PointerEvent && event.pointerType === 'mouse';
        pinned = !mouseClick;
        openPreview(mouseClick ? event : undefined);
      }
    });
    itemPreview.addEventListener('pointerenter', () => { pointerWithin = true; cancelClose(); });
    itemPreview.addEventListener('pointerleave', pointerLeft);
    document.addEventListener('pointermove', event => {
      if (event.pointerType === 'touch' || !itemPreview.matches(':popover-open')) return;
      pointerDriven = true;
      pinned = false;
      const containsPoint = (element: HTMLElement) => {
        const bounds = element.getBoundingClientRect();
        return event.clientX >= bounds.left && event.clientX <= bounds.right && event.clientY >= bounds.top && event.clientY <= bounds.bottom;
      };
      pointerWithin = containsPoint(itemTrigger) || containsPoint(itemPreview);
      if (pointerWithin) cancelClose();
      else scheduleClose();
    });
    document.documentElement.addEventListener('pointerleave', pointerLeft);
    window.addEventListener('blur', closePreview);
    itemTrigger.addEventListener('blur', scheduleClose);
    itemPreview.addEventListener('focusout', scheduleClose);
    itemPreview.addEventListener('toggle', () => {
      const open = itemPreview.matches(':popover-open');
      itemTrigger.setAttribute('aria-expanded', String(open));
      if (!open) pinned = false;
    });
    window.addEventListener('resize', closePreview);
    window.addEventListener('scroll', closePreview, { passive: true });
  }
  const canvas = document.querySelector<HTMLCanvasElement>('.water-back');
  const foreground = document.querySelector<HTMLCanvasElement>('.water-front');
  const context = canvas?.getContext('2d');
  const frontContext = foreground?.getContext('2d');
  if (canvas && context && foreground && frontContext) {
    const waterCanvas = canvas;
    const waterContext = context;
    const frontCanvas = foreground;
    const front = frontContext;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const waterToggle = document.querySelector<HTMLButtonElement>('.water-toggle');
    const mascots = Array.from(document.querySelectorAll<HTMLElement>('.brand img'));
    const driftingRod = document.querySelector<HTMLElement>('.drifting-rod');
    const driftingBanana = document.querySelector<HTMLElement>('.drifting-banana');
    let nextDrift = 6;
    let driftStart = 0;
    let driftDuration = 18;
    let driftingObject: HTMLElement | null = null;
    const names = mascots.map(mascot => mascot.parentElement?.querySelector<HTMLElement>('span'));
    let brandPositions: number[] = [];
    let mascotHeights: number[] = [];
    let frame = 0;
    let footerVisible = true;
    let cssWidth = 1;
    let cssHeight = 1;
    let waterShade: CanvasGradient;
    let frontShade: CanvasGradient;
    let waterReflection: CanvasGradient;
    const waterline = 72;
    let stormTarget = 0;
    let stormLevel = 0;
    let simulationSeconds = 0;
    let previousTime = 0;

    function wave(x: number, seconds: number) {
      const phase = x * 0.011 - seconds * 0.9;
      return Math.sin(phase) * 12 + Math.sin(phase * 2 + 0.4) * (1.5 + stormLevel * 2.5);
    }

    function paint(time: number) {
      const seconds = time / 1000;
      const surface = new Path2D();
      surface.moveTo(0, waterline + wave(0, seconds));
      for (let x = 8; x < cssWidth; x += 8) {
        surface.lineTo(x, waterline + wave(x, seconds));
      }
      surface.lineTo(cssWidth, waterline + wave(cssWidth, seconds));
      const fill = new Path2D(surface);
      fill.lineTo(cssWidth, cssHeight);
      fill.lineTo(0, cssHeight);
      fill.closePath();
      waterContext.clearRect(0, 0, cssWidth, cssHeight);
      front.clearRect(0, 0, cssWidth, cssHeight);
      const distantSurface = new Path2D();
      distantSurface.moveTo(0, waterline - 7 + wave(0, seconds - 0.7) * 0.6);
      for (let x = 8; x < cssWidth; x += 8) distantSurface.lineTo(x, waterline - 7 + wave(x, seconds - 0.7) * 0.6);
      distantSurface.lineTo(cssWidth, waterline - 7 + wave(cssWidth, seconds - 0.7) * 0.6);
      distantSurface.lineTo(cssWidth, cssHeight);
      distantSurface.lineTo(0, cssHeight);
      distantSurface.closePath();
      waterContext.fillStyle = '#294759';
      waterContext.fill(distantSurface);
      waterContext.fillStyle = waterShade;
      waterContext.fill(fill);
      front.fillStyle = frontShade;
      front.fill(fill);
      front.save();
      front.clip(fill);
      front.fillStyle = waterReflection;
      front.fillRect(0, 0, cssWidth, cssHeight);
      front.restore();
      front.strokeStyle = 'rgba(129, 185, 201, 0.35)';
      front.lineWidth = 1.5;
      front.stroke(surface);
      if (!reducedMotion.matches && seconds >= nextDrift && !driftingObject) {
        // Random quiet gaps and a smaller chance of a leisurely banana passage.
        driftingObject = Math.random() < 0.28 ? driftingBanana : driftingRod;
        driftStart = seconds;
        driftDuration = driftingObject === driftingBanana ? 30 : 18;
        nextDrift = seconds + driftDuration + 14 + Math.random() * 22;
      }
      if (driftingObject) {
        const passage = seconds - driftStart;
        const visible = !reducedMotion.matches && passage < driftDuration;
        driftingObject.style.opacity = visible ? '1' : '0';
        if (!visible) driftingObject = null;
        else {
          const banana = driftingObject === driftingBanana;
          const x = -64 + (cssWidth + 128) * passage / driftDuration;
          const buoyancy = Math.sin(seconds * 2.3 + 0.8) * 2.5;
          const center = x + (banana ? 24 : 18);
          const bob = wave(center, seconds) + buoyancy;
          const slope = (wave(center + 1, seconds) - wave(center - 1, seconds)) / 2;
          const tilt = (banana ? -18 : 38) + Math.atan(slope) * 180 / Math.PI * (banana ? 0.9 : 1.5)
            + Math.sin(seconds * (banana ? 1.2 : 1.8) + 0.4) * (banana ? 5 : 10);
          driftingObject.style.transform = `translate(${x.toFixed(2)}px, ${bob.toFixed(2)}px) rotate(${tilt.toFixed(2)}deg)${banana ? ' scaleX(-1)' : ''}`;
        }
      }
      mascots.forEach((mascot, index) => {
        const x = brandPositions[index] ?? 0;
        const bob = wave(x, seconds);
        const depth = mascot.closest('.maomaoprince') ? 0.23 : 0.18;
        const offset = bob - (mascotHeights[index] ?? 56) * depth;
        const slope = (wave(x + 1, seconds) - wave(x - 1, seconds)) / 2;
        const restingTilt = mascot.closest('.maomaoprince') ? -7 : 0;
        const rocking = Math.max(-8, Math.min(8, Math.atan(slope) * 180 / Math.PI * 0.9));
        const tilt = restingTilt + (reducedMotion.matches ? 0 : rocking);
        mascot.style.transform = `translateY(${offset.toFixed(2)}px) rotate(${tilt.toFixed(2)}deg)`;
        const name = names[index];
        if (name) name.style.transform = `translateY(${(bob - 76 - (mascotHeights[index] ?? 56) / 2).toFixed(2)}px)`;
      });
    }

    function animate(time: number) {
      const elapsed = previousTime ? Math.min((time - previousTime) / 1000, 0.05) : 0;
      previousTime = time;
      stormLevel += (stormTarget - stormLevel) * (1 - Math.exp(-elapsed * 3));
      simulationSeconds += elapsed * (1 + stormLevel * 1.2);
      paint(simulationSeconds * 1000);
      frame = requestAnimationFrame(animate);
    }

    function resize() {
      cssWidth = waterCanvas.clientWidth;
      cssHeight = waterCanvas.clientHeight;
      const scale = Math.min(window.devicePixelRatio || 1, 2);
      waterCanvas.width = frontCanvas.width = Math.max(1, Math.round(cssWidth * scale));
      waterCanvas.height = frontCanvas.height = Math.max(1, Math.round(cssHeight * scale));
      waterContext.setTransform(scale, 0, 0, scale, 0, 0);
      front.setTransform(scale, 0, 0, scale, 0, 0);
      waterShade = waterContext.createLinearGradient(0, waterline - 20, 0, cssHeight);
      waterShade.addColorStop(0, '#244d65');
      waterShade.addColorStop(1, '#0b2033');
      frontShade = front.createLinearGradient(0, waterline - 20, 0, cssHeight);
      frontShade.addColorStop(0, 'rgba(36, 77, 101, 0.62)');
      frontShade.addColorStop(1, 'rgba(11, 32, 51, 0.88)');
      waterReflection = front.createRadialGradient(cssWidth * 0.65, waterline, 0, cssWidth * 0.65, waterline, Math.min(320, cssWidth * 0.45));
      waterReflection.addColorStop(0, 'rgba(179, 205, 225, 0.07)');
      waterReflection.addColorStop(1, 'rgba(179, 205, 225, 0)');
      const waterBounds = waterCanvas.getBoundingClientRect();
      brandPositions = mascots.map(mascot => {
        const bounds = mascot.getBoundingClientRect();
        return bounds.left + bounds.width / 2 - waterBounds.left;
      });
      mascotHeights = mascots.map(mascot => mascot.clientHeight);
      paint(reducedMotion.matches ? 0 : simulationSeconds * 1000);
    }

    function updateMotion() {
      cancelAnimationFrame(frame);
      previousTime = 0;
      if (reducedMotion.matches) paint(0);
      else if (!document.hidden && footerVisible) {
        paint(simulationSeconds * 1000);
        frame = requestAnimationFrame(animate);
      }
    }

    waterToggle?.addEventListener('click', () => {
      stormTarget = stormTarget ? 0 : 1;
      waterToggle.setAttribute('aria-pressed', String(Boolean(stormTarget)));
      waterToggle.setAttribute('aria-label', stormTarget ? 'Calm the water' : 'Make the water choppier and faster');
      waterToggle.title = stormTarget ? 'Click to calm the water' : 'Click for choppy water';
      if (reducedMotion.matches) {
        stormLevel = stormTarget;
        paint(0);
      }
    });

    new ResizeObserver(resize).observe(waterCanvas);
    document.fonts.ready.then(resize);
    reducedMotion.addEventListener('change', updateMotion);
    document.addEventListener('visibilitychange', updateMotion);
    new IntersectionObserver(entries => {
      footerVisible = entries[0].isIntersecting;
      updateMotion();
    }).observe(waterCanvas);
    resize();
    updateMotion();
  }
</script>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    background: #111824;
    color: #f0f4fb;
  }
  * { box-sizing: border-box; }
  body {
    position: relative;
    isolation: isolate;
    background:
      radial-gradient(ellipse 22% 15% at 72% 12%, #72528a12, #72528a00 100%),
      radial-gradient(ellipse 15% 12% at 19% 25%, #91536f0b, #91536f00 100%),
      linear-gradient(180deg, #070a12 0%, #0c1320 55%, #132334 100%);
    margin: 0;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    gap: clamp(0.75rem, 1.5vh, 1.25rem);
    padding: 0;
  }
  body::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: url('/sky-grain.svg') repeat; opacity: 0.035; }
  .night-sky { position: absolute; inset: 0 0 auto; height: min(54vh, 400px); overflow: hidden; z-index: -1; pointer-events: none; mask-image: linear-gradient(#000 45%, transparent); }
  .star { position: absolute; border-radius: 50%; background: #d6e1ed; opacity: var(--star-opacity); animation: twinkle 8s ease-in-out infinite; }
  @keyframes twinkle {
    0%, 100% { opacity: var(--star-opacity); background: #d6e1ed; }
    35% { opacity: calc(var(--star-opacity) * 0.45); background: #d6e1ed; }
    65% { opacity: calc(var(--star-opacity) * 1.3); background: var(--star-tint); }
  }
  @media (prefers-reduced-motion: reduce) {
    .star { animation: none; }
  }
  .site-header { width: 100%; padding: clamp(0.875rem, 2vh, 1.5rem) clamp(1rem, 3vw, 2.5rem); display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  main { width: calc(100% - clamp(2rem, 8vw, 6rem)); max-width: 74rem; margin: 0; align-self: start; padding-top: clamp(0rem, 1vh, 0.75rem); text-align: center; }
  img { display: block; object-fit: contain; }
  .hero-mascot { width: clamp(72px, calc(48px + 6vw), 160px); height: clamp(72px, calc(48px + 6vw), 160px); margin: 0 auto clamp(0.75rem, 2vh, 1.25rem); }
  .site-name { display: inline-flex; align-items: center; min-height: 2rem; gap: 0.75rem; color: #b9c9de; font-size: 0.9375rem; font-weight: 600; line-height: 1.25; text-decoration: none; }
  .site-name span { transform: translateY(-1px); }
  h1 { margin: 0 auto clamp(1rem, 2vh, 1.5rem); font-size: clamp(1.5rem, calc(1.15rem + 1.25vw), 2.25rem); font-weight: 600; color: #fff; line-height: 1.28; text-wrap: balance; letter-spacing: -0.02em; }
  .item-name { color: #e7bd67; font: inherit; font-weight: 700; letter-spacing: 0; border: 0; padding: 0; background: none; cursor: pointer; }
  .item-name:hover { color: #f3ce82; }
  .item-name:focus-visible { outline: 2px solid #e7bd67; outline-offset: 4px; border-radius: 3px; }
  .item-bracket { color: #fff; display: inline-block; margin-inline: 0.08em; font-weight: 400; }
  .rod-preview { position: fixed; inset: auto; margin: 0; width: 290px; max-width: calc(100vw - 24px); padding: 14px; border: 1px solid #b9a17559; border-radius: 8px; background: #141923; color: #c9d0df; box-shadow: 0 12px 36px #0006; font-size: 13px; line-height: 1.45; }
  .rod-preview::backdrop { background: transparent; pointer-events: none; }
  .rod-title { display: flex; align-items: center; gap: 10px; }
  .rod-title img { border: 1px solid #e7bd6759; border-radius: 3px; background: #24232a; }
  .rod-title strong { color: #e7bd67; font-size: 14px; font-weight: 600; }
  .rod-title small { display: block; margin-top: 2px; color: #909aaf; font-size: 11px; }
  .rod-preview p { margin: 9px 0; }
  .rod-preview .rod-requirement { color: #b4cca0; }
  .rod-preview dl { padding-top: 9px; margin: 10px 0; border-top: 1px solid #ffffff12; }
  .rod-preview dl div { display: flex; justify-content: space-between; gap: 12px; margin: 3px 0; }
  .rod-preview dd { margin: 0; color: #e7bd67; }
  .rod-preview a { font-size: 11px; }
  a { color: #a6d9f5; font-size: clamp(1rem, 2.5vw, 1.125rem); line-height: 1.7; overflow-wrap: anywhere; text-underline-offset: 0.2em; }
  a:hover { color: #d6efff; }
  a:focus-visible { outline: 2px solid #a6d9f5; outline-offset: 6px; border-radius: 2px; }
  .quest { max-width: 56rem; margin: clamp(1.25rem, 4vh, 2rem) auto 0; padding-top: clamp(1rem, 2vh, 1.5rem); border-top: 1px solid #ffffff14; }
  .quest h2 { margin: 0 0 0.75rem; font-size: clamp(1.0625rem, calc(0.95rem + 0.3vw), 1.25rem); font-weight: 500; color: #fff; line-height: 1.45; text-wrap: balance; }
